{
  "name": "usg-nat-manager",
  "version": "1.1.8",
  "description": "华为USG防火墙NAT管理软件",
  "main": "dist/main/main.js",
  "author": "Crystal",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build:main && concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5174 && cross-env NODE_ENV=development electron .",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "clean:main": "node scripts/build/clean-main-dist.cjs",
    "build:main": "npm run clean:main && tsc -p tsconfig.main.json",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "postinstall": "prisma generate && install-electron",
    "test": "npm run test:src && node --test scripts/release/sign-update.test.cjs scripts/release/signing-credentials.test.cjs",
    "test:src": "node scripts/test/run-src-tests.cjs",
    "lint": "eslint src --ext .ts,.tsx --report-unused-disable-directives",
    "lint:strict": "eslint src --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "type-check": "tsc --noEmit",
    "version:update": "node scripts/release/update-version.js"
  },
  "dependencies": {
    "@ant-design/icons": "^5.2.6",
    "@prisma/client": "^5.7.1",
    "@tanstack/react-query": "^5.14.2",
    "@types/nodemailer": "^8.0.1",
    "antd": "^5.12.2",
    "axios": "^1.6.2",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.10",
    "https-proxy-agent": "^7.0.2",
    "i18next": "^25.6.0",
    "node-schedule": "^2.1.1",
    "nodemailer": "^9.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^16.2.1",
    "react-router-dom": "^6.20.1",
    "ssh2": "^1.15.0",
    "winston": "^3.11.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/crypto-js": "^4.2.1",
    "@types/node": "^20.10.5",
    "@types/node-schedule": "^2.1.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/ssh2": "^1.11.19",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.0.12",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "postcss": "^8.4.32",
    "prettier": "^3.6.2",
    "prisma": "^5.7.1",
    "rcedit": "^4.0.1",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.crystal.usg-nat-manager",
    "productName": "华为USG防火墙NAT管理软件",
    "afterPack": "scripts/build/after-pack-win.cjs",
    "npmRebuild": false,
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/.prisma/**/*",
      "**/node_modules/@prisma/engines/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "resources/icons",
        "to": ".",
        "filter": [
          "icon.ico"
        ]
      }
    ],
    "files": [
      "dist/**/*",
      "resources/**/*",
      "!**/Thumbs.db",
      "package.json",
      "prisma/schema.prisma",
      "!prisma/*.db",
      "!prisma/*.db-journal",
      {
        "from": "node_modules/.prisma",
        "to": "node_modules/.prisma",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/@prisma",
        "to": "node_modules/@prisma",
        "filter": [
          "**/*",
          "!**/*.node.gz"
        ]
      }
    ],
    "extraMetadata": {
      "main": "dist/main/main.js"
    },
    "forceCodeSigning": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "USG-NAT-Manager",
      "icon": "resources/icons/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "resources/icons/icon.ico",
      "uninstallerIcon": "resources/icons/icon.ico",
      "installerHeaderIcon": "resources/icons/icon.ico",
      "artifactName": "USG-NAT-Manager-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "USG-NAT-Manager-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/icons/icon.icns",
      "category": "public.app-category.utilities",
      "artifactName": "USG-NAT-Manager-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/build/entitlements.mac.plist",
      "entitlementsInherit": "resources/build/entitlements.mac.plist"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "artifactName": "USG-NAT-Manager-${version}.${ext}",
      "title": "华为USG防火墙NAT管理软件",
      "backgroundColor": "#ffffff"
    },
    "publish": null
  }
}
