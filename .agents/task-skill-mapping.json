{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "version": "2.0.0",
  "description": "任务到技能与 Prompt 框架的映射配置，用于在 2.0 模板中路由任务、知识库和验证要求。",
  "mappings": [
    {
      "task": "T01-Requirement-Clarification",
      "name": "需求澄清",
      "priority": "high",
      "keywords": ["需求不清楚", "需求澄清", "理解需求", "验收标准", "范围", "用户故事"],
      "recommended_skills": ["product-spec-builder"],
      "prompt_template": ".agents/prompts/T01-Requirement-Clarification.md",
      "prompt_frameworks": ["CRISPE", "ICIO"],
      "checklist": ["需求完整性", "用户与场景", "范围边界", "验收标准", "规模与约束"]
    },
    {
      "task": "T02-Feature-Implementation",
      "name": "功能实现",
      "priority": "high",
      "keywords": ["实现功能", "开发需求", "编写代码", "实现特性", "新功能", "feature", "implement"],
      "recommended_skills": ["dev-builder"],
      "prompt_template": ".agents/prompts/T02-Feature-Implementation.md",
      "prompt_frameworks": ["CRISPE", "BROKE"],
      "checklist": ["功能完整性", "SOLID 原则", "算法复杂度", "错误处理", "测试与验证"],
      "knowledge_focus": ["algorithms", "design-patterns", "ai-prompt"]
    },
    {
      "task": "T03-Bug-Reproduction",
      "name": "Bug 诊断",
      "priority": "high",
      "keywords": ["修复bug", "代码有问题", "功能不正常", "bug", "缺陷", "异常", "error"],
      "recommended_skills": ["bug-fixer"],
      "prompt_template": ".agents/prompts/T03-Bug-Reproduction.md",
      "prompt_frameworks": ["ICIO", "Chain-of-Thought"],
      "checklist": ["重现步骤", "环境信息", "日志与堆栈", "根因分析", "回归验证"]
    },
    {
      "task": "T04-Refactor-With-Safety",
      "name": "安全重构",
      "priority": "medium",
      "keywords": ["重构代码", "优化结构", "消除重复", "refactor", "改善代码", "技术债"],
      "recommended_skills": ["dev-builder", "code-review"],
      "prompt_template": ".agents/prompts/T04-Refactor-With-Safety.md",
      "prompt_frameworks": ["CRISPE"],
      "checklist": ["行为保持", "职责拆分", "依赖方向", "复杂度降低", "验证通过"]
    },
    {
      "task": "T05-Unit-Test-Generation",
      "name": "单元测试生成",
      "priority": "medium",
      "keywords": ["编写测试", "单元测试", "提升覆盖率", "test", "测试用例"],
      "recommended_skills": ["dev-builder"],
      "prompt_template": ".agents/prompts/T05-Unit-Test-Generation.md",
      "prompt_frameworks": ["BROKE"],
      "checklist": ["失败先行", "主路径", "边界测试", "异常测试", "真实断言"]
    },
    {
      "task": "T06-Integration-Test-Plan",
      "name": "集成测试计划",
      "priority": "medium",
      "keywords": ["集成测试", "端到端测试", "接口测试", "e2e", "integration"],
      "recommended_skills": ["dev-planner"],
      "prompt_template": ".agents/prompts/T06-Integration-Test-Plan.md",
      "prompt_frameworks": ["CRISPE"],
      "checklist": ["接口契约", "数据流", "依赖准备", "错误传播", "验证步骤"]
    },
    {
      "task": "T07-Code-Review",
      "name": "代码审查",
      "priority": "high",
      "keywords": ["审查代码", "code review", "检查质量", "review", "审核"],
      "recommended_skills": ["code-review"],
      "prompt_template": ".agents/prompts/T07-Code-Review.md",
      "prompt_frameworks": ["BROKE", "CRISPE"],
      "checklist": ["需求正确性", "架构边界", "SOLID 原则", "安全", "性能", "测试真实性"]
    },
    {
      "task": "T08-Architecture-Decision",
      "name": "架构决策",
      "priority": "high",
      "keywords": ["架构设计", "技术选型", "设计方案", "architecture", "系统设计"],
      "recommended_skills": ["dev-planner"],
      "prompt_template": ".agents/prompts/T08-Architecture-Decision.md",
      "prompt_frameworks": ["ROBOTIC", "CRISPE"],
      "checklist": ["问题驱动", "候选方案", "权衡分析", "风险评估", "验证方式"],
      "knowledge_focus": ["design-patterns", "algorithms", "ai-prompt"]
    },
    {
      "task": "T09-API-Contract-Design",
      "name": "API 契约设计",
      "priority": "medium",
      "keywords": ["API设计", "接口设计", "定义契约", "RESTful", "GraphQL", "接口规范"],
      "recommended_skills": ["product-spec-builder", "dev-planner"],
      "prompt_template": ".agents/prompts/T09-API-Contract-Design.md",
      "prompt_frameworks": ["CRISPE"],
      "checklist": ["资源模型", "参数与返回", "错误码设计", "版本兼容", "示例完整性"]
    },
    {
      "task": "T10-SQL-Query-Optimization",
      "name": "SQL 查询优化",
      "priority": "medium",
      "keywords": ["SQL优化", "查询慢", "数据库性能", "慢查询", "数据库优化"],
      "recommended_skills": ["bug-fixer", "dev-builder"],
      "prompt_template": ".agents/prompts/T10-SQL-Query-Optimization.md",
      "prompt_frameworks": ["Chain-of-Thought"],
      "checklist": ["执行计划", "索引", "复杂度", "N+1 问题", "验证数据"]
    },
    {
      "task": "T11-Security-Review",
      "name": "安全审查",
      "priority": "high",
      "keywords": ["安全审查", "安全检查", "漏洞扫描", "security", "安全"],
      "recommended_skills": ["code-review"],
      "prompt_template": ".agents/prompts/T11-Security-Review.md",
      "prompt_frameworks": ["CRISPE"],
      "checklist": ["SQL 注入", "XSS", "CSRF", "认证授权", "敏感信息", "依赖风险"]
    },
    {
      "task": "T12-Performance-Optimization",
      "name": "性能优化",
      "priority": "high",
      "keywords": ["性能优化", "太慢了", "加速", "优化速度", "卡顿", "慢", "performance"],
      "recommended_skills": ["dev-builder", "bug-fixer"],
      "prompt_template": ".agents/prompts/T12-Performance-Optimization.md",
      "prompt_frameworks": ["Chain-of-Thought", "CRISPE"],
      "checklist": ["测量基线", "瓶颈定位", "复杂度优化", "缓存/并发策略", "效果验证"],
      "knowledge_focus": ["algorithms", "ai-prompt"]
    },
    {
      "task": "T13-Legacy-Code-Understanding",
      "name": "遗留代码理解",
      "priority": "medium",
      "keywords": ["理解代码", "分析逻辑", "老代码", "legacy", "遗留系统"],
      "recommended_skills": ["bug-fixer", "dev-planner"],
      "prompt_template": ".agents/prompts/T13-Legacy-Code-Understanding.md",
      "prompt_frameworks": ["ICIO"],
      "checklist": ["调用链", "状态流", "依赖关系", "风险点", "重构机会"]
    },
    {
      "task": "T14-Documentation-Generation",
      "name": "文档生成",
      "priority": "low",
      "keywords": ["生成文档", "写文档", "API文档", "documentation", "readme"],
      "recommended_skills": ["product-spec-builder", "dev-planner"],
      "prompt_template": ".agents/prompts/T14-Documentation-Generation.md",
      "prompt_frameworks": ["BROKE", "CRISPE"],
      "checklist": ["受众明确", "结构完整", "示例真实", "同步维护", "版本信息"]
    }
  ],
  "usage_guide": {
    "steps": [
      "1. 解析用户输入，识别任务场景和关键词",
      "2. 选择对应 task 的 prompt_template 和 recommended_skills",
      "3. 结合 prompt_frameworks 组织上下文",
      "4. 按 checklist 补齐约束、证据和验收条件",
      "5. 如涉及性能或架构，额外查阅 knowledge_focus"
    ],
    "example": "用户输入: '实现用户登录 API，并要求 100ms 内返回' -> T02 + CRISPE/BROKE + dev-builder，并追加复杂度与性能验证约束"
  }
}
